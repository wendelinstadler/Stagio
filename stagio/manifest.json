{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.4.0",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "tabGroups",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "browsingData",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stagio",
    "default_popup": "popup.html"
  },
  "commands": {
    "next-env": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_cmdNext__"
    },
    "env-1": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "__MSG_cmd1__"
    },
    "env-2": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "__MSG_cmd2__"
    },
    "env-3": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "__MSG_cmd3__"
    },
    "open-api": {
      "description": "__MSG_cmdApi__"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "homepage_url": "https://usestagio.app",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "key": ""
}
