{
  "manifest_version": 3,
  "name": "EnvSwitch",
  "version": "2.3.0",
  "description": "Wechselt zwischen lokaler, Test- und Live-Umgebung, öffnet Seiten wie Backoffice mit einem Klick und testet APIs im Swagger-Stil.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "tabGroups",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EnvSwitch",
    "default_popup": "popup.html"
  },
  "commands": {
    "next-env": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Zur nächsten Umgebung wechseln"
    },
    "env-1": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Zur 1. Umgebung wechseln"
    },
    "env-2": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Zur 2. Umgebung wechseln"
    },
    "env-3": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Zur 3. Umgebung wechseln"
    },
    "open-api": {
      "description": "API-Tester öffnen"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "homepage_url": "https://github.com/wendelinstadler/envswitch"
}
